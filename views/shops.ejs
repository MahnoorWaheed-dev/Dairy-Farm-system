<%- include('partials/header') %>

<div  class="min-h-screen bg-gray-50 flex flex-col lg:flex-row w-full overflow-x-hidden pt-16 lg:pt-0">
    <%- include('partials/sidebar') %>

    <!-- Main Content Area: Responsive Margin and Padding -->
    <main class="flex-1 lg:ml-64 p-4 sm:p-6 md:p-8 w-full overflow-x-hidden min-w-0 main-content">
      
        <header class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-4 mb-6 sm:mb-8 bg-sidebarBg p-4 sm:p-5 rounded-2xl shadow-lg border border-slate-700/80">

    <!-- Brand Logo & Titles -->
    <div class="flex items-center space-x-3 sm:space-x-4 w-full xl:w-auto min-w-0">

        <div class="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 rounded-2xl flex items-center justify-center shrink-0 shadow-md border border-brandTeal/40 p-2 overflow-hidden">
            <img src="/assets/white-shopping-centre.png" alt="Mangrio Logo" class="w-full h-full object-contain" />
        </div>

        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <h2 class="text-base sm:text-lg md:text-xl font-semibold text-brandTeal tracking-wider uppercase truncate">
                    MANGRIO SHOPPING CENTRE
                </h2>

                <span class="text-[10px] sm:text-xs font-medium text-slate-300 bg-slate-900/80 px-2 py-0.5 rounded-full border border-slate-700 shrink-0">
                    Shops & Rent
                </span>
            </div>

            <p class="text-xs sm:text-sm font-normal text-slate-300 mt-1 truncate">
                منگريو شاپنگ سينٽر <span class="text-slate-500 mx-1">|</span> Proprietor: Haji Muhammad Ramzan Mangrio
            </p>
        </div>
    </div>

    <!-- Header Action Buttons & Status Summary -->
    <div class="flex flex-col sm:flex-row xl:flex-row items-stretch sm:items-center gap-2 w-full xl:w-auto shrink-0 min-w-0">

        <!-- Status Badge -->
        <div class="bg-slate-900/90 border border-slate-700/80 px-2 py-2 rounded-xl flex items-center justify-around sm:justify-start gap-3 shadow-inner shrink-0">
            
            <div class="flex items-center gap-1.5" title="Paid Shops">
                <span class="w-2.5 h-2.5 rounded-full bg-brandTeal animate-pulse"></span>
                <span class="text-xs font-medium text-slate-300">Paid:</span>
                <span class="text-xs font-bold text-brandTeal">
                    <%= typeof paidShopsCount !== 'undefined' ? paidShopsCount : 0 %>
                </span>
            </div>

            <span class="text-slate-700 font-light">|</span>

            <div class="flex items-center gap-1.5" title="Pending Shops">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                <span class="text-xs font-medium text-slate-300">Pending:</span>
                <span class="text-xs font-bold text-rose-400">
                    <%= typeof pendingShopsCount !== 'undefined' ? pendingShopsCount : 0 %>
                </span>
            </div>
        </div>

        <!-- Buttons Container with Spacing -->
        <div class="flex flex-wrap sm:flex-nowrap items-stretch sm:items-center gap-2 w-full sm:w-auto min-w-0">

            <!-- Other Income / Statement Button -->
            <a href="/shops/other-income" 
               class="bg-slate-800 hover:bg-slate-900 text-white font-medium px-2 py-2.5 rounded-xl text-sm transition-all shadow-md flex items-center justify-center gap-2 border border-slate-700/60 flex-1 sm:flex-none whitespace-nowrap min-w-0">
                <i class="fa-solid fa-file-invoice-dollar text-brandTeal"></i>
                <span>Other Income</span>
            </a>

            <!-- Add Button -->
            <button onclick="document.getElementById('addShopModal').classList.remove('hidden')"
                class="bg-brandTeal hover:bg-[#008F80] text-white font-medium px-2 py-2.5 rounded-xl text-sm transition-all shadow-md flex items-center justify-center gap-2 flex-1 sm:flex-none whitespace-nowrap min-w-0">
                <i class="fa-solid fa-plus"></i>
                <span>Add New Shop</span>
            </button>

        </div>
    </div>
</header>

        <!-- Shops List Table -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-4 border-b border-gray-100 flex justify-between items-center">
                <h3 class="font-bold text-gray-700 text-sm sm:text-base">Shops List</h3>
            </div>

            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse min-w-[640px]">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs text-gray-500 uppercase tracking-wider">
                            <th class="p-3 sm:p-4">Shop No</th>
                            <th class="p-3 sm:p-4">Shop Owner / Person</th>
                            <th class="p-3 sm:p-4">Contact</th>
                            <th class="p-3 sm:p-4">Monthly Rent</th>
                            <th class="p-3 sm:p-4">Status</th>
                            <th class="p-3 sm:p-4 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-xs sm:text-sm">
                        <% if (shops.length === 0) { %>
                            <tr>
                                <td colspan="6" class="p-8 text-center text-gray-400 font-medium">
                                    No shops added yet. Click "Add New Shop" to create your first record.
                                </td>
                            </tr>
                        <% } else { %>
                            <% shops.forEach(shop => { %>
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="p-3 sm:p-4 font-bold text-gray-800">#<%= shop.shopNumber %></td>
                                    <td class="p-3 sm:p-4 font-semibold text-gray-700 whitespace-nowrap"><%= shop.personName %></td>
                                    <td class="p-3 sm:p-4 text-gray-500 whitespace-nowrap"><%= shop.contactNumber %></td>
                                    <td class="p-3 sm:p-4 font-bold text-gray-800 whitespace-nowrap">Rs. <%= shop.monthlyRent.toLocaleString() %></td>
                                    <td class="p-3 sm:p-4">
                                        <% if (shop.status === 'Paid') { %>
                                            <span class="px-2.5 py-1 text-[11px] sm:text-xs font-bold rounded-full bg-emerald-100 text-emerald-700">Paid</span>
                                        <% } else { %>
                                            <span class="px-2.5 py-1 text-[11px] sm:text-xs font-bold rounded-full bg-rose-100 text-rose-700">Pending</span>
                                        <% } %>
                                    </td>

                                    <!-- Action Cell -->
                                    <td class="p-3 sm:p-4 text-center">
                                        <div class="flex items-center justify-center space-x-2 sm:space-x-3">
                                            <button
                                                onclick="openRentModal('<%= shop._id %>', '<%= shop.shopNumber %>', '<%= shop.personName %>', '<%= shop.monthlyRent %>')"
                                                class="text-brandTeal hover:text-[#008F80] text-xs font-semibold flex items-center gap-1 transition-colors">
                                                <i class="fa-solid fa-money-bill-wave"></i> <span class="hidden lg:inline">Pay Rent</span>
                                            </button>

                                            <button
                                                onclick="openEditModal('<%= shop._id %>', '<%= shop.shopNumber %>', '<%= shop.personName %>', '<%= shop.contactNumber %>', '<%= shop.monthlyRent %>', '<%= shop.rentDueDate %>', '<%= shop.status %>')"
                                                class="text-blue-600 hover:text-blue-800 text-xs font-bold flex items-center gap-1">
                                                <i class="fa-solid fa-pen"></i> <span class="hidden lg:inline">Edit</span>
                                            </button>

                                            <form action="/shops/delete/<%= shop._id %>" method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this shop?');">
                                                <button type="submit"
                                                    class="text-rose-600 hover:text-rose-800 text-xs font-bold flex items-center gap-1">
                                                    <i class="fa-solid fa-trash"></i> <span class="hidden lg:inline">Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Controls -->
        <% if (totalPages > 1) { %>
            <div class="flex flex-col sm:flex-row items-center justify-between border-t border-slate-200 bg-white px-4 py-3 rounded-xl mt-6 shadow-sm gap-4">
                <div class="text-center sm:text-left">
                    <p class="text-xs text-slate-600">
                        Showing Page <span class="font-bold text-slate-900"><%= currentPage %></span> of <span class="font-bold text-slate-900"><%= totalPages %></span>
                        (<span class="font-bold text-brandTeal"><%= totalShops %></span> Total Shops)
                    </p>
                </div>

                <nav class="inline-flex gap-1" aria-label="Pagination">
                    <a href="/shops?page=<%= currentPage - 1 %>"
                        class="relative inline-flex items-center rounded-lg px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-slate-600 border border-slate-300 hover:bg-slate-100 transition-colors <%= currentPage === 1 ? 'pointer-events-none opacity-40' : '' %>">
                        <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                    </a>

                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/shops?page=<%= i %>"
                            class="relative inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors <%= currentPage === i ? 'bg-brandTeal text-white' : 'text-slate-700 border border-slate-300 hover:bg-slate-100' %>">
                            <%= i %>
                        </a>
                    <% } %>

                    <a href="/shops?page=<%= currentPage + 1 %>"
                        class="relative inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 border border-slate-300 hover:bg-slate-100 transition-colors <%= currentPage === totalPages ? 'pointer-events-none opacity-40' : '' %>">
                        Next <i class="fa-solid fa-chevron-right ml-1"></i>
                    </a>
                </nav>
            </div>
        <% } %>
    </main>
</div>

<!-- Add Shop Modal -->
<div id="addShopModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl border border-gray-100 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 sm:mb-6">
            <h3 class="text-base sm:text-lg font-bold text-gray-800">Add New Shop</h3>
            <button onclick="document.getElementById('addShopModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 p-1">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <form action="/shops/add" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Shop Number</label>
                <input type="text" name="shopNumber" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal" placeholder="e.g. 101">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Owner / Person Name</label>
                <input type="text" name="personName" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal" placeholder="e.g. Ali Raza">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Contact Number</label>
                <input type="text" name="contactNumber" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal" placeholder="0300-1234567">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Monthly Rent (Rs.)</label>
                <input type="number" name="monthlyRent" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal" placeholder="10000">
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="document.getElementById('addShopModal').classList.add('hidden')" class="px-4 py-2 text-xs sm:text-sm font-semibold text-gray-500 hover:text-gray-700">Cancel</button>
                <button type="submit" class="px-5 py-2 text-xs sm:text-sm font-bold bg-brandTeal text-white rounded-lg shadow-md hover:bg-teal-600">Save Shop</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Shop Modal -->
<div id="editShopModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl border border-gray-100 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 sm:mb-6">
            <h3 class="text-base sm:text-lg font-bold text-gray-800">Edit Shop Details</h3>
            <button onclick="document.getElementById('editShopModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 p-1">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <form id="editShopForm" action="" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Shop Number</label>
                <input type="text" id="editShopNumber" name="shopNumber" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Owner / Person Name</label>
                <input type="text" id="editPersonName" name="personName" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Contact Number</label>
                <input type="text" id="editContactNumber" name="contactNumber" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Monthly Rent (Rs.)</label>
                <input type="number" id="editMonthlyRent" name="monthlyRent" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Rent Status</label>
                <select id="editStatus" name="status" class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal">
                    <option value="Pending">Pending</option>
                    <option value="Paid">Paid</option>
                </select>
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="document.getElementById('editShopModal').classList.add('hidden')" class="px-4 py-2 text-xs sm:text-sm font-semibold text-gray-500 hover:text-gray-700">Cancel</button>
                <button type="submit" class="px-5 py-2 text-xs sm:text-sm font-bold bg-brandTeal text-white rounded-lg shadow-md hover:bg-teal-600">Update Shop</button>
            </div>
        </form>
    </div>
</div>

<!-- Collect Rent Modal -->
<div id="collectRentModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl border border-gray-100 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 sm:mb-6">
            <h3 class="text-base sm:text-lg font-bold text-gray-800">Record Rent Payment</h3>
            <button onclick="document.getElementById('collectRentModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 p-1">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <form action="/shops/collect-rent" method="POST" class="space-y-4">
            <input type="hidden" id="rentShopId" name="shopId">

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Shop & Tenant</label>
                <input type="text" id="rentShopInfo" readonly class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg bg-gray-100 border border-gray-200 text-gray-700 text-sm font-semibold">
            </div>

            <!-- Month & Year Selectors (Fully Responsive Grid) -->
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Rent Period</label>
                <div class="grid grid-cols-2 gap-3">
                    <!-- Month Dropdown -->
                    <div>
                        <select name="month" required class="w-full px-3 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal bg-white font-medium text-gray-800">
                            <% const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; %>
                            <% const currentMonth = new Date().toLocaleString('en-US', { month: 'short' }); %>
                            <% months.forEach(m => { %>
                                <option value="<%= m %>" <%= currentMonth === m ? 'selected' : '' %>><%= m %></option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Year Dropdown -->
                    <div>
                        <select name="year" required class="w-full px-3 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal bg-white font-medium text-gray-800">
                            <% const currentYear = new Date().getFullYear(); %>
                            <% for(let y = currentYear - 1; y <= currentYear + 2; y++) { %>
                                <option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y %></option>
                            <% } %>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Amount Paid & Payment Status (2 Column Grid for Responsiveness) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Amount Paid (Rs.)</label>
                    <input type="number" id="rentAmountPaid" name="amountPaid" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Payment Status</label>
                    <select name="status" required class="w-full px-3 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-brandTeal bg-white font-semibold text-emerald-700">
                        <option value="Paid" selected>Paid</option>
                        <option value="Pending" class="text-amber-600">Pending</option>
                        <option value="Partial" class="text-blue-600">Partial</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Received By</label>
                <input type="text" name="receivedBy" value="Haji Muhammad Ramadan Mangrio" required class="w-full px-3.5 py-2 sm:py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:border-emerald-600 font-medium text-gray-800" />
            </div>

            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="document.getElementById('collectRentModal').classList.add('hidden')" class="px-4 py-2 text-xs sm:text-sm font-semibold text-gray-500 hover:text-gray-700">Cancel</button>
                <button type="submit" class="px-4 sm:px-5 py-2 text-xs sm:text-sm font-bold bg-emerald-600 text-white rounded-lg shadow-md hover:bg-emerald-700 flex items-center gap-2 shrink-0">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Save & Print Receipt</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditModal(id, shopNumber, personName, contactNumber, monthlyRent, rentDueDate, status) {
        document.getElementById('editShopForm').action = '/shops/edit/' + id;
        document.getElementById('editShopNumber').value = shopNumber;
        document.getElementById('editPersonName').value = personName;
        document.getElementById('editContactNumber').value = contactNumber;
        document.getElementById('editMonthlyRent').value = monthlyRent;
        document.getElementById('editStatus').value = status;
        document.getElementById('editShopModal').classList.remove('hidden');
    }

    function openRentModal(id, shopNumber, personName, monthlyRent) {
        document.getElementById('rentShopId').value = id;
        document.getElementById('rentShopInfo').value = 'Shop #' + shopNumber + ' - ' + personName;
        document.getElementById('rentAmountPaid').value = monthlyRent;
        document.getElementById('collectRentModal').classList.remove('hidden');
    }
</script>

<%- include('partials/footer') %>