<%- include('partials/header') %>

    <div class="min-h-screen bg-gray-50 flex flex-col lg:flex-row w-full overflow-x-hidden">
        <%- include('partials/sidebar') %>

            <main class="flex-1 lg:ml-64 p-4 sm:p-6 md:p-8 w-full overflow-x-hidden min-w-0 main-content">
                <!-- Header & Year Selector (No Print) -->
                <div
                    class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 bg-sidebarBg p-4 sm:p-5 rounded-2xl shadow-lg border border-slate-700/80">
                    <div>
                        <h2 class="text-xl font-bold text-brandTeal">Other Income / Yearly Rent Statements</h2>
                        <p class="text-xs text-slate-300">Annual payment track record for all shops</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <!-- Year Filter Dropdown -->
                        <form method="GET" action="/shops/other-income" class="flex items-center gap-2">
                            <label class="text-xs font-bold text-slate-300">Year:</label>
                            <select name="year" onchange="this.form.submit()"
                                class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-white font-semibold">
                                <% [2024, 2025, 2026, 2027].forEach(y=> { %>
                                    <option value="<%= y %>" <%=selectedYear===y ? 'selected' : '' %>><%= y %>
                                    </option>
                                    <% }) %>
                            </select>
                        </form>
                        <!-- Full Page Print Button -->
                        <button onclick="window.print()"
                            class="bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold px-4 py-2 rounded-lg flex items-center gap-2">
                            <i class="fa-solid fa-print"></i> Print Full Report
                        </button>
                    </div>
                </div>
                <!-- Yearly Records Grid/List -->
                <div class="space-y-6 print-container">
                    <% if (!yearlyData || yearlyData.length === 0) { %>
                        <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500 font-medium shadow-sm">
                            No records found for the selected year.
                        </div>
                    <% } else { %>
                        <% yearlyData.forEach(item=> { %>
                            <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm page-break">

                                <!-- Shop & Person Header -->
                                <div class="flex justify-between items-center border-b border-gray-100 pb-3 mb-4">
                                    <div>
                                        <h3 class="text-base font-bold text-gray-800">
                                            Shop #<%= item.shopNumber %> - <%= item.personName %>
                                        </h3>
                                        <p class="text-xs text-gray-500">Contact: <%= item.contactNumber %> | Monthly Rent:
                                                Rs. <%= item.monthlyRent.toLocaleString() %>
                                        </p>
                                    </div>

                                    <div class="text-right flex items-center gap-3">
                                        <div>
                                            <span
                                                class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                                                Paid: <%= item.totalPaidMonths %>/12 Months
                                            </span>
                                        </div>

                                        <!-- Single Person Print Button -->
                                        <button onclick="printSingleStatement('statement-<%= item._id %>')"
                                            class="no-print text-xs bg-brandTeal text-white px-3 py-1.5 rounded-lg hover:bg-teal-700">
                                            <i class="fa-solid fa-print"></i> Print Statement
                                        </button>
                                    </div>
                                </div>

                                <!-- 12 Months Visual Strike Matrix -->
                                <div id="statement-<%= item._id %>">
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
                                        Annual Payment Track Record (<%= selectedYear %>)
                                    </p>

                                    <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-12 gap-2 text-center">
                                        <% item.monthStatus.forEach(m=> { %>
                                            <% if (m.isPaid) { %>
                                                <div
                                                    class="p-2.5 rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-700 text-xs font-bold">
                                                    <%= m.month %>
                                                        <div class="text-emerald-600 mt-1"><i
                                                                class="fa-solid fa-circle-check"></i> Paid</div>
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        class="p-2.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-500 text-xs font-bold">
                                                        <span class="line-through">
                                                            <%= m.month %>
                                                        </span>
                                                        <div class="text-rose-400 mt-1"><i
                                                                class="fa-solid fa-circle-xmark"></i> Pending</div>
                                                    </div>
                                                    <% } %>
                                                        <% }) %>
                                    </div>
                                </div>

                            </div>
                            <% }) %>
                    <% } %>
                </div>

                <!-- Pagination Controls (10 Per Page) -->
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <div class="no-print flex flex-col sm:flex-row items-center justify-between border-t border-slate-200 bg-white px-4 py-3 rounded-xl mt-6 shadow-sm gap-4">
                        <div class="text-center sm:text-left">
                            <p class="text-xs text-slate-600">
                                Showing Page <span class="font-bold text-slate-900"><%= currentPage %></span> of <span class="font-bold text-slate-900"><%= totalPages %></span>
                                (<span class="font-bold text-brandTeal"><%= totalRecords %></span> Total Records)
                            </p>
                        </div>

                        <nav class="inline-flex gap-1" aria-label="Pagination">
                            <a href="/shops/other-income?year=<%= selectedYear %>&page=<%= currentPage - 1 %>"
                                class="relative inline-flex items-center rounded-lg px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-slate-600 border border-slate-300 hover:bg-slate-100 transition-colors <%= currentPage === 1 ? 'pointer-events-none opacity-40' : '' %>">
                                <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                            </a>

                            <% for(let i = 1; i <= totalPages; i++) { %>
                                <a href="/shops/other-income?year=<%= selectedYear %>&page=<%= i %>"
                                    class="relative inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors <%= currentPage === i ? 'bg-brandTeal text-white' : 'text-slate-700 border border-slate-300 hover:bg-slate-100' %>">
                                    <%= i %>
                                </a>
                            <% } %>

                            <a href="/shops/other-income?year=<%= selectedYear %>&page=<%= currentPage + 1 %>"
                                class="relative inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-600 border border-slate-300 hover:bg-slate-100 transition-colors <%= currentPage === totalPages ? 'pointer-events-none opacity-40' : '' %>">
                                Next <i class="fa-solid fa-chevron-right ml-1"></i>
                            </a>
                        </nav>
                    </div>
                <% } %>
            </main>
    </div>
    <!-- Script to Print Individual Tenant Statement -->
    <script>
        function printSingleStatement(elementId) {
            const printContent = document.getElementById(elementId).innerHTML;
            const originalContent = document.body.innerHTML;

            document.body.innerHTML = `
            <div style="padding: 20px; font-family: sans-serif;">
                <h2 style="text-align: center; color: #008F80;">MANGRIO SHOPPING CENTRE</h2>
                <p style="text-align: center; margin-bottom: 20px;">Proprietor: Haji Muhammad Ramzan Mangrio</p>
                <hr />
                ${printContent}
            </div>
   `;
            window.print();
            document.body.innerHTML = originalContent;
            window.location.reload();
        }
    </script>
    <%- include('partials/footer') %>