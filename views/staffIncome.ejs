<%- include('partials/header') %>

<!-- Print Friendly CSS Styles -->
<style>
    @media print {
        /* Hide Header, Sidebar, Buttons, Modals, Filters */
        nav, header, sidebar, .no-print, button, #addIncomeModal, form {
            display: none !important;
        }
        
        /* Reset Layout for Print */
        body {
            background-color: white !important;
            color: black !important;
        }
        
        .main-content {
            margin-left: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        /* Print Header Styling */
        .print-header {
            display: block !important;
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }

        /* Table Styling for Print */
        table {
            width: 100% !important;
            border-collapse: collapse !important;
        }

        th, td {
            border: 1px solid #cbd5e1 !important;
            padding: 8px !important;
            color: black !important;
        }

        .shadow-sm, .shadow-lg, .shadow-2xl {
            box-shadow: none !important;
        }

        .border {
            border-color: #e2e8f0 !important;
        }
    }

    /* Hide Print Title Header on Normal Screen */
    .print-header {
        display: none;
    }
</style>

<div class="min-h-screen bg-gray-50 flex flex-col lg:flex-row w-full overflow-x-hidden pt-16 lg:pt-0">
    <%- include('partials/sidebar') %>

    <main class="flex-1 lg:ml-64 p-4 sm:p-6 md:p-8 w-full overflow-x-hidden min-w-0 main-content ">

        <!-- Special Header visible ONLY in Print -->
        <div class="print-header">
            <h1 class="text-2xl font-bold">KAMRAN DAIRY FARM & GIRHORI FARM DHORONARO</h1>
            <h2 class="text-lg font-semibold text-gray-700">Staff Other Income Report</h2>
            <p class="text-xs text-gray-500">Filter Period: <%= selectedMonth %> <%= selectedYear %> | Generated Date: <%= new Date().toLocaleDateString('en-GB') %></p>
        </div>

        <!-- Top Header Card -->
        <div class="bg-slate-900 text-white  rounded-2xl p-5 md:p-6 shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border border-slate-800">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-teal-500/10 rounded-xl flex items-center justify-center border border-teal-500/20 text-teal-400">
                    <i class="fa-solid fa-wallet text-2xl"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h1 class="text-xl md:text-2xl font-bold tracking-tight">Staff Other Income</h1>
                        <span class="bg-teal-500/20 text-teal-300 text-xs px-2.5 py-0.5 rounded-full font-medium border border-teal-500/30">General Entry</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5">Kamran Dairy Farm & Girhori Farm Dhoronaro</p>
                </div>
            </div>

            <div class="flex items-center space-x-2 no-print">
                <!-- Print Button -->
                <button onclick="window.print()" 
                        class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs md:text-sm px-4 py-2.5 rounded-xl transition shadow-md flex items-center space-x-2 border border-slate-700">
                    <i class="fa-solid fa-print"></i>
                    <span>Print Report</span>
                </button>

                <!-- Add Entry Button -->
                <button onclick="document.getElementById('addIncomeModal').classList.remove('hidden')" 
                        class="bg-teal-500 hover:bg-teal-600 text-white font-semibold text-xs md:text-sm px-4 py-2.5 rounded-xl transition shadow-md flex items-center space-x-2">
                    <i class="fa-solid fa-circle-plus"></i>
                    <span>Add Entry</span>
                </button>
            </div>
        </div>

        <!-- Filter & Summary Bar -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 space-y-6">
            
            <!-- Filters Form -->
            <div class="md:col-span-2 bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80 flex flex-wrap items-center justify-between gap-3 no-print">
                <form action="/staff-income" method="GET" class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Select Year</label>
                        <select name="year" onchange="this.form.submit()" class="text-xs font-semibold p-2 border border-slate-200 rounded-lg bg-slate-50 text-slate-700 focus:outline-none focus:border-teal-500">
                            <% const currentY = new Date().getFullYear(); %>
                            <% for(let y = currentY; y >= currentY - 5; y--) { %>
                                <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>><%= y %></option>
                            <% } %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Select Month</label>
                        <select name="month" onchange="this.form.submit()" class="text-xs font-semibold p-2 border border-slate-200 rounded-lg bg-slate-50 text-slate-700 focus:outline-none focus:border-teal-500">
                            <option value="All" <%= selectedMonth === 'All' ? 'selected' : '' %>>All Months</option>
                            <% ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].forEach(m => { %>
                                <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
                            <% }) %>
                        </select>
                    </div>
                </form>

                <div class="text-xs text-slate-500 font-medium">
                    Showing records for: <span class="text-slate-800 font-bold"><%= selectedMonth %> <%= selectedYear %></span>
                </div>
            </div>

            <!-- Total Amount Card -->
            <div class="bg-teal-500/10 border border-teal-500/20 rounded-2xl p-4 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-bold text-teal-800 uppercase tracking-wider">Total Other Income</p>
                    <p class="text-2xl font-black text-teal-700 mt-1">Rs. <%= totalStaffIncomeAmount.toLocaleString() %></p>
                </div>
                <div class="w-10 h-10 bg-teal-500 text-white rounded-xl flex items-center justify-center shadow-sm no-print">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
            </div>

        </div>

        <!-- Table View Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between no-print">
                <h2 class="text-sm font-bold text-slate-800 flex items-center space-x-2">
                    <i class="fa-solid fa-list-check text-slate-400"></i>
                    <span>Income Transactions List</span>
                </h2>
                <span class="text-xs font-semibold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-lg">
                    <%= incomes.length %> Entries Found
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3 px-4">Source Title</th>
                            <th class="py-3 px-4">Category</th>
                            <th class="py-3 px-4">Notes / Remarks</th>
                            <th class="py-3 px-4 text-right">Amount (Rs.)</th>
                            <th class="py-3 px-4 text-center no-print">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                        <% if(incomes && incomes.length > 0) { %>
                            <% incomes.forEach(item => { %>
                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="py-3.5 px-4 font-medium text-slate-500">
                                        <%= new Date(item.date).toLocaleDateString('en-GB') %>
                                    </td>
                                    <td class="py-3.5 px-4 font-bold text-slate-800">
                                        <%= item.sourceTitle %>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="bg-slate-100 text-slate-700 text-[11px] font-semibold px-2 py-0.5 rounded-md border border-slate-200">
                                            <%= item.category || 'General' %>
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-slate-500 max-w-xs truncate">
                                        <%= item.notes || '-' %>
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-black text-teal-600 text-sm">
                                        + Rs. <%= Number(item.amount).toLocaleString() %>
                                    </td>
                                    <td class="py-3.5 px-4 text-center no-print">
                                        <a href="/staff-income/delete/<%= item._id %>" 
                                           onclick="return confirm('Are you sure you want to delete this record?')" 
                                           class="inline-flex items-center justify-center w-7 h-7 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition" 
                                           title="Delete Entry">
                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="py-8 text-center text-slate-400">
                                    <i class="fa-solid fa-folder-open text-3xl mb-2 block text-slate-300"></i>
                                    No other income records found for this period.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>

<!-- ADD OTHER INCOME MODAL -->
<div id="addIncomeModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 no-print">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-base font-bold text-slate-800 flex items-center space-x-2">
                <i class="fa-solid fa-plus-circle text-teal-600"></i>
                <span>Add Staff Other Income Entry</span>
            </h3>
            <button onclick="document.getElementById('addIncomeModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Form -->
        <form action="/staff-income/add" method="POST" class="space-y-4">
            
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Title / Source Name <span class="text-red-500">*</span></label>
                <input type="text" name="sourceTitle" placeholder="e.g., Scrap Sale, Rent, Extra Services" required class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Category</label>
                    <select name="category" class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50">
                        <option value="General">General Income</option>
                        <option value="Commission">Commission</option>
                        <option value="Rent/Services">Rent / Services</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Amount (Rs.) <span class="text-red-500">*</span></label>
                    <input type="number" name="amount" placeholder="0.00" step="any" required class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Month</label>
                    <select name="month" class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50">
                        <% const currM = new Date().toLocaleString('en-US', { month: 'short' }); %>
                        <% ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].forEach(m => { %>
                            <option value="<%= m %>" <%= currM === m ? 'selected' : '' %>><%= m %></option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Year</label>
                    <input type="text" name="year" value="<%= new Date().getFullYear() %>" required class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Date</label>
                <input type="date" name="date" class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50">
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Notes / Remarks (Optional)</label>
                <textarea name="notes" rows="2" placeholder="Any additional details..." class="w-full text-xs p-2.5 border border-slate-200 rounded-lg text-slate-800 focus:outline-none focus:border-teal-500 bg-slate-50/50"></textarea>
            </div>

            <div class="pt-2 flex space-x-2">
                <button type="button" onclick="document.getElementById('addIncomeModal').classList.add('hidden')" class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs py-2.5 rounded-xl transition">Cancel</button>
                <button type="submit" class="w-1/2 bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs py-2.5 rounded-xl transition">Save Income Entry</button>
            </div>
        </form>

    </div>
</div>

<%- include('partials/footer') %>