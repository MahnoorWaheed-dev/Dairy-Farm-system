<%- include('partials/header') %>

<div class="flex min-h-screen bg-slate-100">
    <%- include('partials/sidebar') %>

    <div class="flex-1 md:ml-64 flex flex-col min-w-0 overflow-hidden">
        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            
            <!-- Page Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
                <div>
                    <h1 class="text-2xl font-black text-slate-800">Agriculture & Baghaat Management</h1>
                    <p class="text-xs text-gray-500 font-semibold">Track Mango & Banana Gardens, Expenses, and Crop Sales</p>
                </div>
                <button onclick="document.getElementById('addGardenModal').classList.remove('hidden')" 
                    class="bg-brandTeal hover:bg-teal-600 text-white font-bold px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-seedling"></i> Add New Garden
                </button>
            </div>

            <!-- Garden Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                <% if (gardens.length === 0) { %>
                    <div class="col-span-full bg-white p-8 text-center rounded-2xl border border-gray-200 text-gray-400 font-medium">
                        No garden records found. Click "Add New Garden" to get started.
                    </div>
                <% } else { %>
                    <% gardens.forEach(garden => { %>
                        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-4">
                                    <div>
                                        <h3 class="font-extrabold text-lg text-slate-800"><%= garden.name %></h3>
                                        <p class="text-xs text-gray-400 font-semibold"><%= garden.areaSize || 'N/A' %></p>
                                    </div>
                                    <span class="px-3 py-1 text-xs font-black rounded-full <%= garden.cropType === 'Mango' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>">
                                        <%= garden.cropType %>
                                    </span>
                                </div>

                                <div class="space-y-2 py-3 border-y border-gray-100 text-xs">
                                    <div class="flex justify-between">
                                        <span class="text-gray-500 font-semibold">Total Income:</span>
                                        <span class="font-bold text-emerald-600">Rs. <%= garden.totalIncome.toLocaleString() %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-500 font-semibold">Total Expense:</span>
                                        <span class="font-bold text-rose-600">Rs. <%= garden.totalExpense.toLocaleString() %></span>
                                    </div>
                                    <div class="flex justify-between pt-2 border-t border-dashed border-gray-200 font-black">
                                        <span class="text-gray-700">Net Profit / Loss:</span>
                                        <span class="<%= garden.netProfit >= 0 ? 'text-emerald-600' : 'text-rose-600' %>">
                                            Rs. <%= garden.netProfit.toLocaleString() %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-4 mt-2">
                                <button onclick="openGardenTransModal('<%= garden._id %>', '<%= garden.name %>')" 
                                    class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 rounded-xl text-xs transition flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-plus-circle"></i> Add Income / Expense
                                </button>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

        </main>
    </div>
</div>

<!-- Modal: Add Garden -->
<div id="addGardenModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Add Garden / Baagh</h3>
        <form action="/gardens/add" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Garden Name</label>
                <input type="text" name="name" required placeholder="e.g. Mango Garden Block A" class="w-full px-4 py-2 rounded-lg border border-gray-300">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Crop Type</label>
                <select name="cropType" required class="w-full px-4 py-2 rounded-lg border border-gray-300">
                    <option value="Mango">Mango (Aam)</option>
                    <option value="Banana">Banana (Kela)</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Area Size</label>
                <input type="text" name="areaSize" placeholder="e.g. 5 Acres" class="w-full px-4 py-2 rounded-lg border border-gray-300">
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t">
                <button type="button" onclick="document.getElementById('addGardenModal').classList.add('hidden')" class="px-4 py-2 text-sm font-semibold text-gray-500">Cancel</button>
                <button type="submit" class="px-5 py-2 text-sm font-bold bg-brandTeal text-white rounded-lg">Save Garden</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Garden Transaction -->
<div id="gardenTransModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Record Garden Entry</h3>
        <form action="/gardens/transaction" method="POST" class="space-y-4">
            <input type="hidden" id="transGardenId" name="gardenId">

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Selected Garden</label>
                <input type="text" id="transGardenName" readonly class="w-full px-4 py-2 rounded-lg bg-gray-100 font-bold text-gray-700">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Type</label>
                <select name="category" required class="w-full px-4 py-2 rounded-lg border border-gray-300">
                    <option value="EXPENSE">EXPENSE (Khad, Pani, Dihadi, Transport)</option>
                    <option value="INCOME">INCOME (Crop Sale / Income)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Title / Description</label>
                <input type="text" name="title" required placeholder="e.g. Fertilizer Purchase" class="w-full px-4 py-2 rounded-lg border border-gray-300">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Amount (Rs.)</label>
                <input type="number" name="amount" required class="w-full px-4 py-2 rounded-lg border border-gray-300">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Additional Notes</label>
                <input type="text" name="notes" placeholder="Optional details..." class="w-full px-4 py-2 rounded-lg border border-gray-300">
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t">
                <button type="button" onclick="document.getElementById('gardenTransModal').classList.add('hidden')" class="px-4 py-2 text-sm font-semibold text-gray-500">Cancel</button>
                <button type="submit" class="px-5 py-2 text-sm font-bold bg-slate-800 text-white rounded-lg">Save Entry</button>
            </div>
        </form>
    </div>
</div>

<script>
function openGardenTransModal(id, name) {
    document.getElementById('transGardenId').value = id;
    document.getElementById('transGardenName').value = name;
    document.getElementById('gardenTransModal').classList.remove('hidden');
}
</script>

<%- include('partials/footer') %>