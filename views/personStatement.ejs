<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statement - <%= person.name %> - Mangrio Shopping Centre</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandTeal: '#008F80',
                        brandTealDark: '#007266',
                        sidebarBg: '#0f172a'
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            .no-print {
                display: none !important;
            }

            body {
                background-color: #fff !important;
                color: #000 !important;
                padding: 0 !important;
            }

            .print-card {
                border: 1px solid #ccc !important;
                box-shadow: none !important;
                background: #fff !important;
                color: #000 !important;
            }

            .print-text {
                color: #000 !important;
            }

            table {
                border-collapse: collapse !important;
                width: 100% !important;
            }

            th,
            td {
                border: 1px solid #ddd !important;
                color: #000 !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen p-3 sm:p-6 font-sans">
    <div class="max-w-5xl mx-auto space-y-6">
        <!-- Top Actions (No Print) -->
        <div class="flex justify-between items-center no-print">
            <a href="/person"
                class="bg-white hover:bg-slate-200/70 text-slate-800 px-4 py-2 rounded-xl text-sm font-bold border border-slate-300 flex items-center gap-2 shadow-xs transition duration-150">
                <i class="fa-solid fa-arrow-left text-brandTeal"></i> Back to Persons
            </a>
            <button onclick="window.print()"
                class="bg-brandTeal hover:bg-brandTealDark text-white px-5 py-2 rounded-xl text-sm font-bold shadow-sm hover:shadow-md flex items-center gap-2 transition duration-150 active:scale-95">
                <i class="fa-solid fa-print"></i> Print Statement
            </button>
        </div>
        
        <!-- Statement Sheet Card -->
        <div class="bg-white print-card rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200/90 space-y-6">
            <!-- Header Info -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200 pb-6">
                <div class="flex items-center space-x-4">
                    <div class="w-16 h-16 rounded-2xl bg-teal-50/50 flex items-center justify-center shrink-0 shadow-xs border border-brandTeal/30 p-1.5 overflow-hidden">
                        <img src="/assets/dark-dairy-farm-logo.png" alt="Mangrio Logo"
                            class="w-full h-full object-contain" />
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-extrabold text-brandTeal uppercase tracking-wide print-text">
                            GIRHORI FARM DHORONARO
                        </h1>
                        <h1 class="text-xl sm:text-1xl font-extrabold text-slate-800 uppercase tracking-wide print-text">
                            & KAMRAN DAIRY FARM 
                        </h1>
                         
                        
                        <p class="text-xs sm:text-sm font-semibold text-slate-600 print-text">Account Statement & Ledger Record</p>
                    </div>
                </div>
                <div class="text-left sm:text-right">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Statement Date</span>
                    <span class="text-sm font-mono font-bold text-slate-900 print-text">
                        <%= new Date().toLocaleDateString('en-GB') %>
                    </span>
                </div>
            </div>

            <!-- Person Details Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 print-card">
                <div>
                    <span class="text-xs font-semibold text-slate-500 block print-text">Person Name</span>
                    <span class="text-base font-bold text-slate-900 print-text">
                        <%= person.name %>
                    </span>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 block print-text">CNIC Number</span>
                    <span class="text-sm font-mono font-bold text-slate-800 print-text">
                        <%= person.cnic %>
                    </span>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 block print-text">Mobile Number</span>
                    <span class="text-sm font-mono font-bold text-slate-800 print-text">
                        <%= person.mobile %>
                    </span>
                </div>
            </div>

            <!-- Enhanced Summary Metrics -->
            <% 
                let totalDebit = 0;
                let totalCredit = 0;
                if (person.transactions && person.transactions.length > 0) {
                    person.transactions.forEach(t => {
                        if (t.type === 'Debit') totalDebit += t.amount;
                        if (t.type === 'Credit') totalCredit += t.amount;
                    });
                }
            %>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 print-card">
                <div class="bg-rose-50/60 p-3 rounded-xl border border-rose-100">
                    <span class="text-xs font-semibold text-rose-700 block">Total Charged / Given</span>
                    <span class="text-lg font-bold font-mono text-rose-800">Rs. <%= totalDebit.toLocaleString() %></span>
                </div>
                <div class="bg-emerald-50/60 p-3 rounded-xl border border-emerald-100">
                    <span class="text-xs font-semibold text-emerald-700 block">Total Received / Paid</span>
                    <span class="text-lg font-bold font-mono text-emerald-800">Rs. <%= totalCredit.toLocaleString() %></span>
                </div>
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <span class="text-xs font-semibold text-slate-600 block">Net Outstanding Balance</span>
                    <span class="text-lg font-bold font-mono <%= person.currentBalance < 0 ? 'text-rose-700' : 'text-emerald-800' %>">
                        Rs. <%= person.currentBalance ? person.currentBalance.toLocaleString() : 0 %>
                    </span>
                </div>
            </div>

            <!-- Transactions Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-700">
                    <thead class="bg-slate-100/90 text-xs font-bold uppercase text-slate-700 border-b border-slate-200 print-card">
                        <tr>
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3 px-4">Description</th>
                            <th class="py-3 px-4 text-center">Type</th>
                            <th class="py-3 px-4 text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (person.transactions && person.transactions.length > 0) { %>
                            <% person.transactions.forEach(t=> { %>
                                <tr class="hover:bg-slate-50/80 transition-colors print-card">
                                    <td class="py-3 px-4 font-mono text-xs font-semibold text-slate-600 print-text">
                                        <%= new Date(t.date).toLocaleDateString('en-GB') %>
                                    </td>
                                    <td class="py-3 px-4 text-slate-900 font-semibold print-text">
                                        <%= t.description %>
                                    </td>
                                    <td class="py-3 px-4 text-center">
                                        <span class="text-[11px] font-bold px-2.5 py-1 rounded-md <%= t.type === 'Debit' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200' %> print-text">
                                            <%= t.type %>
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-bold text-slate-900 print-text">
                                        Rs. <%= t.amount.toLocaleString() %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="py-6 text-center font-medium text-slate-500 print-text">
                                    No transaction history recorded yet.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Footer Signature Space for Printouts -->
            <div class="pt-8 border-t border-slate-200 grid grid-cols-2 gap-8 items-end print-card">
                <div>
                    <p class="text-[11px] text-slate-400 font-medium">Note: Computer generated statement. E.&O.E.</p>
                </div>
                <div class="text-right space-y-6">
                    <div class="border-b border-slate-400 w-48 ml-auto"></div>
                    <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">Authorized Signature & Stamp</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>