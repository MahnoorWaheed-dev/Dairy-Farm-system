<%- include('partials/header') %>

<div class="min-h-screen bg-gray-50 flex flex-col lg:flex-row w-full overflow-x-hidden pt-16 lg:pt-0">
    
    <!-- Sidebar Partial -->
    <%- include('partials/sidebar') %>

    <!-- Main Workspace -->
    <main class="flex-1 lg:ml-64 p-4 sm:p-6 md:p-8 w-full overflow-x-hidden min-w-0 main-content">
        
 <!-- Header Strip -->
<div class="bg-[#0f172a] px-4 md:px-6 py-4 rounded-xl border border-slate-700/60 shadow-lg 
            flex flex-row justify-between items-center gap-2">

    <!-- Page Title -->
    <h1 class="text-lg md:text-2xl font-bold text-white whitespace-nowrap">
        Dashboard
    </h1>

    <!-- User Info -->
    <div class="flex items-center gap-1.5 text-[10px] sm:text-xs font-semibold 
                text-slate-200 bg-slate-800/60 border border-slate-600/60 
                px-2 sm:px-3 py-1.5 rounded-lg whitespace-nowrap">

        <i class="fa-solid fa-user-gear text-teal-400"></i>

        <span>
            <%= user ? user.username : 'Admin' %>
            (<%= user ? user.role : 'Owner' %>)
        </span>

    </div>

</div>
        <!-- Top 4 Clean Metric Cards (Exact Reference Alignment) -->
        <div class="grid grid-cols-1 pt-3 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            
            <!-- Card 1: Total Entities -->
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center space-y-1">
                <p class="text-xs font-semibold text-slate-500">Total Shops / Assets</p>
                <h2 class="text-3xl font-extrabold text-blue-600"><%= totalShops || 0 %></h2>
            </div>

            <!-- Card 2: Total Monthly Rent -->
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center space-y-1">
                <p class="text-xs font-semibold text-slate-500">Total Monthly Rent</p>
                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-800">
                    Rs. <%= Number(totalMonthlyRent || 0).toLocaleString() %>
                </h2>
            </div>

            <!-- Card 3: Rent Received -->
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center space-y-1">
                <p class="text-xs font-semibold text-slate-500">Received (This Month)</p>
                <h2 class="text-2xl md:text-3xl font-extrabold text-emerald-600">
                    Rs. <%= Number(receivedThisMonth || 0).toLocaleString() %>
                </h2>
            </div>

            <!-- Card 4: Pending Rent -->
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center space-y-1">
                <p class="text-xs font-semibold text-slate-500">Pending (This Month)</p>
                <h2 class="text-2xl md:text-3xl font-extrabold text-rose-500">
                    Rs. <%= Number(pendingThisMonth || 0).toLocaleString() %>
                </h2>
            </div>

        </div>

        <!-- Middle Section: Quick Overview & Quick Actions Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
            
            <!-- Left Side: Quick Overview (Spans 2 Columns) -->
            <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200/70 p-6 shadow-2xs space-y-4">
                <h2 class="text-base font-bold text-slate-800">Quick Overview</h2>
                
                <div class="space-y-2.5 text-xs md:text-sm font-semibold">
                    
                    <!-- Managed Assets Count Strip -->
                    <div class="flex justify-between items-center p-3.5 bg-slate-50/80 rounded-xl border border-slate-100">
                        <span class="text-slate-500">Managed Entities (Shops / Gardens / Staff)</span>
                        <span class="text-slate-800 font-bold">
                            <%= totalShops || 0 %> Shops / <%= totalGardens || 0 %> Gardens / <%= totalStaff || 0 %> Staff
                        </span>
                    </div>

                    <!-- Rent Received Strip -->
                    <div class="flex justify-between items-center p-3.5 bg-slate-50/80 rounded-xl border border-slate-100">
                        <span class="text-slate-500">Rent Received (This Month)</span>
                        <span class="text-emerald-600 font-bold">Rs. <%= Number(receivedThisMonth || 0).toLocaleString() %></span>
                    </div>

                    <!-- Pending Rent Strip -->
                    <div class="flex justify-between items-center p-3.5 bg-slate-50/80 rounded-xl border border-slate-100">
                        <span class="text-slate-500">Rent Pending (This Month)</span>
                        <span class="text-rose-500 font-bold">Rs. <%= Number(pendingThisMonth || 0).toLocaleString() %></span>
                    </div>

                    <!-- Agriculture Income Strip -->
                    <div class="flex justify-between items-center p-3.5 bg-slate-50/80 rounded-xl border border-slate-100">
                        <span class="text-slate-500">Agriculture Income (This Month)</span>
                        <span class="text-emerald-600 font-bold">Rs. <%= Number(agricultureIncome || 0).toLocaleString() %></span>
                    </div>

                    <!-- Total Income Strip -->
                    <div class="flex justify-between items-center p-3.5 bg-slate-50/80 rounded-xl border border-slate-100">
                        <span class="text-slate-500">Total Gross Income (This Month)</span>
                        <span class="text-slate-800 font-bold">Rs. <%= Number(totalIncomeThisMonth || 0).toLocaleString() %></span>
                    </div>

                    <!-- Expenses Strip -->
                    <div class="flex justify-between items-center p-3.5 bg-slate-50/80 rounded-xl border border-slate-100">
                        <span class="text-slate-500">Total Expenses (This Month)</span>
                        <span class="text-rose-500 font-bold">Rs. <%= Number(totalExpensesThisMonth || 0).toLocaleString() %></span>
                    </div>

                    <!-- Net Highlight Strip -->
                    <div class="flex justify-between items-center p-4 bg-emerald-50/80 rounded-xl border border-emerald-100/80">
                        <span class="text-emerald-900 font-bold">Net Balance (This Month)</span>
                        <span class="text-emerald-700 font-extrabold text-base md:text-lg">
                            Rs. <%= Number(netThisMonth || 0).toLocaleString() %>
                        </span>
                    </div>

                </div>
            </div>

            <!-- Right Side: Quick Actions Panel (Exact Reference Layout) -->
            <div class="bg-white rounded-xl border border-slate-200/70 p-6 shadow-2xs space-y-4">
                <h2 class="text-base font-bold text-slate-800">Quick Actions</h2>
                
                <div class="space-y-3">
                    
                    <!-- Action 1: Record Rent -->
                    <a href="/shops" class="flex justify-between items-center p-3.5 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/30 transition text-xs md:text-sm font-semibold text-slate-700 group">
                        <span class="flex items-center gap-2.5">
                            <i class="fa-solid fa-plus text-emerald-600 group-hover:scale-110 transition-transform"></i>
                            Record Rent Payment
                        </span>
                        <i class="fa-solid fa-chevron-right text-slate-400 group-hover:translate-x-1 transition-transform text-xs"></i>
                    </a>

                    <!-- Action 2: Add Staff Transaction -->
                    <a href="/person" class="flex justify-between items-center p-3.5 rounded-xl border border-slate-200 hover:border-blue-500 hover:bg-blue-50/30 transition text-xs md:text-sm font-semibold text-slate-700 group">
                        <span class="flex items-center gap-2.5">
                            <i class="fa-solid fa-user-plus text-blue-600 group-hover:scale-110 transition-transform"></i>
                            Add Staff Transaction
                        </span>
                        <i class="fa-solid fa-chevron-right text-slate-400 group-hover:translate-x-1 transition-transform text-xs"></i>
                    </a>

                    <!-- Action 3: Add Agriculture Entry -->
                    <a href="/garden" class="flex justify-between items-center p-3.5 rounded-xl border border-slate-200 hover:border-amber-500 hover:bg-amber-50/30 transition text-xs md:text-sm font-semibold text-slate-700 group">
                        <span class="flex items-center gap-2.5">
                            <i class="fa-solid fa-seedling text-amber-600 group-hover:scale-110 transition-transform"></i>
                            Add Agriculture Entry
                        </span>
                        <i class="fa-solid fa-chevron-right text-slate-400 group-hover:translate-x-1 transition-transform text-xs"></i>
                    </a>

                </div>
            </div>

        </div>

    </main>
</div>

<%- include('partials/footer') %>