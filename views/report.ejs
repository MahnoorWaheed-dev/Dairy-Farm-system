<%- include('partials/header') %>

<div class="min-h-screen bg-gray-50 flex flex-col lg:flex-row w-full overflow-x-hidden pt-16 lg:pt-0">
    
    <!-- Sidebar (Hidden on Print) -->
    <div class="print:hidden">
        <%- include('partials/sidebar') %>
    </div>

    <!-- Main Content -->
    <main class="flex-1 lg:ml-64 p-4 sm:p-6 md:p-8 w-full overflow-x-hidden min-w-0 main-content"">
        
        <!-- Header & Action Strip -->
        <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs flex justify-between items-center print:border-none print:shadow-none">
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-slate-800">Financial Reports & Ledger</h1>
                <p class="text-xs text-slate-500 mt-0.5">Aggregated Income, Agriculture & Staff Dues Overview</p>
            </div>
            <button onclick="window.print()" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition flex items-center gap-2 print:hidden shadow-2xs">
                <i class="fa-solid fa-print"></i> Print / Download PDF
            </button>
        </div>

        <!-- Consolidated Summary Cards Grid (4 Columns) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center">
                <p class="text-xs font-semibold text-slate-500">Shops Rent Revenue</p>
                <h2 class="text-2xl font-extrabold text-emerald-600 mt-1">Rs. <%= Number(totalRentIncome || 0).toLocaleString() %></h2>
            </div>
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center">
                <p class="text-xs font-semibold text-slate-500">Agriculture Income</p>
                <h2 class="text-2xl font-extrabold text-teal-600 mt-1">Rs. <%= Number(totalGardenIncome || 0).toLocaleString() %></h2>
            </div>
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center">
                <p class="text-xs font-semibold text-slate-500">Staff Total Advances</p>
                <h2 class="text-2xl font-extrabold text-amber-600 mt-1">Rs. <%= Number(totalStaffAdvances || 0).toLocaleString() %></h2>
            </div>
            <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs text-center">
                <p class="text-xs font-semibold text-slate-500">Staff Pending Dues</p>
                <h2 class="text-2xl font-extrabold text-rose-500 mt-1">Rs. <%= Number(totalStaffPending || 0).toLocaleString() %></h2>
            </div>
        </div>

        <!-- Section 1: Shops Rent Collection History -->
        <div class="bg-white rounded-xl border border-slate-200/70 p-6 shadow-2xs space-y-4">
            <h3 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-store text-teal-600"></i> Shops Rent Collections
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs md:text-sm border-collapse">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-extrabold border-y border-slate-200">
                        <tr>
                            <th class="p-3">Receipt #</th>
                            <th class="p-3">Shop Number</th>
                            <th class="p-3">Rent Month</th>
                            <th class="p-3">Status</th>
                            <th class="p-3 text-right">Amount Received</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-semibold text-slate-700">
                        <% if (rentTxList && rentTxList.length > 0) { %>
                            <% rentTxList.forEach(tx => { %>
                                <tr>
                                    <td class="p-3 font-mono text-slate-500"><%= tx.receiptNumber || 'N/A' %></td>
                                    <td class="p-3 font-bold text-slate-800"><%= tx.shopId ? (tx.shopId.shopNumber || tx.shopId.number) : 'N/A' %></td>
                                    <td class="p-3"><%= tx.rentMonth %></td>
                                    <td class="p-3">
                                        <span class="bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-md font-extrabold text-[11px] border border-emerald-200">
                                            <%= tx.status || 'Paid' %>
                                        </span>
                                    </td>
                                    <td class="p-3 text-right font-mono font-bold text-emerald-600">
                                        Rs. <%= Number(tx.amountPaid || tx.amount || 0).toLocaleString() %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="p-4 text-center text-slate-400">No rent transactions found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Agriculture / Garden Income Breakdown -->
        <div class="bg-white rounded-xl border border-slate-200/70 p-6 shadow-2xs space-y-4">
            <h3 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-seedling text-amber-600"></i> Agriculture / Garden Summary
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs md:text-sm border-collapse">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-extrabold border-y border-slate-200">
                        <tr>
                            <th class="p-3">Garden / Land Name</th>
                            <th class="p-3">Contractor / Lessee</th>
                            <th class="p-3">Contract Period</th>
                            <th class="p-3 text-right">Contract / Income Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-semibold text-slate-700">
                      <% if (gardens && gardens.length > 0) { %>
    <% gardens.forEach(g => { %>
        <tr>
            <td class="p-3 font-bold text-slate-800"><%= g.gardenName %></td>
            <td class="p-3"><%= g.currentLease ? (g.currentLease.contractorName || 'Assigned') : 'N/A' %></td>
            <td class="p-3 font-mono text-slate-500"><%= g.status %></td>
            <td class="p-3 text-right font-mono font-bold text-teal-600">
                Rs. <%= g.currentLease ? Number(g.currentLease.totalAmount || g.currentLease.advanceAmount || 0).toLocaleString() : 0 %>
            </td>
        </tr>
    <% }) %>
<% } else { %>
    <tr><td colspan="4" class="p-4 text-center text-slate-400">No agriculture records found.</td></tr>
<% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 3: Staff / Persons Ledger & Advances Breakdown -->
        <div class="bg-white rounded-xl border border-slate-200/70 p-6 shadow-2xs space-y-4">
            <h3 class="text-base font-bold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-users text-blue-600"></i> Staff / Person Ledger & Advance Summary
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs md:text-sm border-collapse">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-extrabold border-y border-slate-200">
                        <tr>
                            <th class="p-3">Staff Name</th>
                            <th class="p-3">Designation / Role</th>
                            <th class="p-3 text-right">Advance Paid (Debit)</th>
                            <th class="p-3 text-right">Pending Dues (Credit)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-semibold text-slate-700">
                     <% if (persons && persons.length > 0) { %>
    <% persons.forEach(p => { %>
        <tr>
            <td class="p-3 font-bold text-slate-800"><%= p.name %></td>
            <td class="p-3 text-slate-500"><%= p.role %></td>
            <td class="p-3 text-right font-mono font-bold text-amber-600">
                Rs. <%= Number(p.calculatedDebit || 0).toLocaleString() %>
            </td>
            <td class="p-3 text-right font-mono font-bold text-rose-500">
                Rs. <%= Number(p.calculatedCredit || 0).toLocaleString() %>
            </td>
        </tr>
    <% }) %>
<% } else { %>
    <tr><td colspan="4" class="p-4 text-center text-slate-400">No staff records found.</td></tr>
<% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>

<%- include('partials/footer') %>