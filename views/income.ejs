<!-- Printable Income Receipt / Voucher Modal -->
<div id="incomeReceiptModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative border border-slate-200 print-wrapper">
        
        <!-- Header Action Controls -->
        <div class="flex justify-between items-center mb-5 no-print border-b border-slate-200 pb-4">
            <h3 class="font-extrabold text-slate-800 text-sm flex items-center gap-2">
                <i class="fa-solid fa-receipt text-brandTeal"></i> Income Voucher Receipt
            </h3>
            <div class="flex gap-2">
                <button onclick="window.print()" class="bg-brandTeal hover:bg-brandTealDark text-white px-4 py-2 rounded-xl text-xs font-bold shadow-xs flex items-center gap-2 transition duration-150 cursor-pointer">
                    <i class="fa-solid fa-print"></i> Print Voucher
                </button>
                <button onclick="document.getElementById('incomeReceiptModal').classList.add('hidden')" class="bg-slate-100 hover:bg-slate-200 text-slate-800 px-3 py-2 rounded-xl text-xs font-bold border border-slate-300 transition duration-150 cursor-pointer">
                    Close
                </button>
            </div>
        </div>

        <!-- Printable Voucher Card Area -->
        <div id="printableIncomeArea" class="bg-white print-card rounded-2xl p-4 sm:p-6 space-y-4">
            
            <!-- Company Header -->
            <div class="flex flex-row justify-between items-center gap-4 border-b border-slate-200 pb-4">
                <div class="flex items-center space-x-3 sm:space-x-4">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-teal-50/50 flex items-center justify-center shrink-0 shadow-xs border border-brandTeal/30 p-1.5 overflow-hidden">
                        <img src="/assets/dark-dairy-farm-logo.png" alt="Farm Logo" class="w-full h-full object-contain" />
                    </div>
                    <div>
                        <h1 class="text-base sm:text-lg font-extrabold text-slate-800 uppercase tracking-wide print-text">
                            KAMRAN DAIRY FARM &
                        </h1>
                        <h1 class="text-base sm:text-xl font-extrabold text-brandTeal uppercase tracking-wide print-text">
                            GIRHORI FARM DHORONARO
                        </h1>
                        <p class="text-xs font-semibold text-slate-600 print-text">Official Income Payment Voucher</p>
                    </div>
                </div>
                <div class="text-right">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">Voucher No</span>
                    <span id="vNo" class="text-xs sm:text-sm font-mono font-bold text-slate-900 print-text">#INC-0000</span>
                </div>
            </div>

            <!-- Receipt Metadata Grid -->
            <div class="space-y-2.5 text-xs sm:text-sm pt-1">
                <div class="flex justify-between border-b border-slate-200 pb-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Received From</span>
                    <span id="vPayer" class="font-extrabold text-slate-900 print-text">---</span>
                </div>
                <div class="flex justify-between border-b border-slate-200 pb-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Income Category</span>
                    <span id="vCategory" class="font-bold text-slate-800 print-text">---</span>
                </div>
                <div class="flex justify-between border-b border-slate-200 pb-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Date & Time</span>
                    <span id="vDate" class="font-mono font-bold text-slate-800 print-text">---</span>
                </div>
                <div class="flex justify-between border-b border-slate-200 pb-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Payment Mode</span>
                    <span id="vMode" class="font-mono font-bold text-slate-800 print-text">Cash</span>
                </div>
                <div class="flex justify-between pt-1.5 items-center bg-teal-50/60 p-2.5 rounded-xl border border-brandTeal/20">
                    <span class="text-xs font-extrabold uppercase tracking-wider text-slate-800">Amount Received</span>
                    <span id="vAmount" class="font-mono font-black text-brandTeal text-base print-text">Rs. 0</span>
                </div>
            </div>

            <!-- Signatures -->
            <div class="mt-6 pt-4 border-t-2 border-dashed border-slate-200 flex justify-between text-xs font-bold text-slate-700">
                <div class="text-center">
                    <p class="border-t border-slate-400 pt-1 mt-4 px-4">Received By (Authorized)</p>
                </div>
                <div class="text-center">
                    <p class="border-t border-slate-400 pt-1 mt-4 px-4">Payer Signature</p>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Responsive & Page-Break Safe Print CSS -->
<style>
@page {
    size: A4 portrait;
    margin: 10mm;
}

@media print {
    html, body {
        height: 100% !important;
        overflow: hidden !important;
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .no-print, header, sidebar, nav, footer, #sidebar {
        display: none !important;
    }

    #incomeReceiptModal {
        visibility: visible !important;
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        display: block !important;
        background: transparent !important;
        padding: 0 !important;
    }

    .print-wrapper {
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 auto !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    #printableIncomeArea {
        visibility: visible !important;
        position: relative !important;
        width: 95% !important;
        max-width: 700px !important;
        margin: 10px auto !important;
        padding: 24px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 16px !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        page-break-after: avoid !important;
    }

    .print-text {
        color: #000000 !important;
        font-weight: 800 !important;
    }
}
</style>
<script>
    function openIncomeVoucher(voucherNo, payer, category, date, mode, amount) {
        document.getElementById('vNo').innerText = '#' + voucherNo;
        document.getElementById('vPayer').innerText = payer;
        document.getElementById('vCategory').innerText = category;
        document.getElementById('vDate').innerText = date;
        document.getElementById('vMode').innerText = mode || 'Cash';
        document.getElementById('vAmount').innerText = 'Rs. ' + Number(amount).toLocaleString();

        document.getElementById('incomeReceiptModal').classList.remove('hidden');
    }
</script>