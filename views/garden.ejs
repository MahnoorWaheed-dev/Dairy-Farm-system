    <script>
        function printGardenReceipt(gardenName, contractorName, totalAmount, advanceAmount, startDate, endDate) {
            const total = Number(totalAmount) || 0;
            const advance = Number(advanceAmount) || 0;
            const balance = total - advance;

            document.getElementById('pGardenName').innerText = gardenName || 'N/A';
            document.getElementById('pContractorName').innerText = contractorName || 'N/A';
            document.getElementById('pTotalAmount').innerText = 'Rs. ' + total.toLocaleString();
            document.getElementById('pAdvanceAmount').innerText = 'Rs. ' + advance.toLocaleString();
            document.getElementById('pBalanceDue').innerText = 'Rs. ' + balance.toLocaleString();

            const start = startDate ? new Date(startDate).toLocaleDateString('en-GB') : '';
            const end = endDate ? new Date(endDate).toLocaleDateString('en-GB') : '';
            document.getElementById('pDates').innerText = (start && end) ? (start + ' to ' + end) : 'N/A';

            document.getElementById('printReceiptModal').classList.remove('hidden');
        }

        // Function to open Assign Lease Modal and pass Garden ID
        function openLeaseModal(gardenId, gardenName) {
            // Garden ID hidden field mein set karein
            const gardenIdInput = document.getElementById('modalGardenId');
            if (gardenIdInput) {
                gardenIdInput.value = gardenId;
            }

            // Modal ko display karein
            const modal = document.getElementById('assignLeaseModal');
            if (modal) {
                modal.classList.remove('hidden');
            }
        }

        // Function to close Assign Lease Modal
        function closeLeaseModal() {
            const modal = document.getElementById('assignLeaseModal');
            if (modal) {
                modal.classList.add('hidden');
            }
        }

        // Open Edit Garden Modal
function openEditGardenModal(gardenId, gardenName, location, areaSize, cropType) {

    document.getElementById('editGardenForm').action = '/garden/edit/' + gardenId;

    document.getElementById('editGardenName').value = gardenName || '';
    document.getElementById('editGardenLocation').value = location || '';
    document.getElementById('editGardenAreaSize').value = areaSize || '';
    document.getElementById('editGardenCropType').value = cropType || '';

    document.getElementById('editGardenModal').classList.remove('hidden');
}
    </script>

